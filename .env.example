# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://tomas-santos.com
NODE_ENV=development

# Figma Integration (for design tokens and assets)
# Get your token from: https://www.figma.com/developers/api#access-tokens
FIGMA_API_TOKEN=your_personal_access_token_here

# Your Figma file ID (from the URL)
# Example: https://www.figma.com/file/6ByJL76V2sXnwg2K1beBBD/Website
FIGMA_FILE_ID=6ByJL76V2sXnwg2K1beBBD

# Optional: Specific node ID to extract (leave empty for full file)
FIGMA_NODE_ID=

# Notion Integration (optional - for live project data)
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Output directories (for Figma sync)
DESIGN_TOKENS_OUTPUT=styles/design-tokens.css
ASSETS_OUTPUT=public/assets
COMPONENTS_OUTPUT=src/components/figma

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Social Media (optional)
NEXT_PUBLIC_TWITTER_USER=tomassantos
NEXT_PUBLIC_GITHUB_USER=santsan00
